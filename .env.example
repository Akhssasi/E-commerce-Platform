# Copy this file to .env and adjust the values before deployment
DB_NAME=souqi
DB_USER=souqi
DB_PASSWORD=souqi

# JWT secret: at least 32 bytes, random in production
JWT_SECRET=change-me-in-production-please-use-at-least-32-bytes-secret

# Initial admin account (created automatically on first startup)
ADMIN_EMAIL=admin@souqi.local
ADMIN_PASSWORD=Admin@12345

# Simulated payment gateway failure rate (0 = always succeeds)
PAYMENT_FAILURE_RATE=0.05
